{
  "name": "correlcore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --filter @correlcore/web dev",
    "build": "pnpm --filter @correlcore/web build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:style-contract": "node scripts/check-style-contract.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "quality:m1": "./scripts/quality-gate-m1.sh",
    "prepare": "git config core.hooksPath .husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.38.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "typescript": "^5.5.0"
  }
}
