{
  "name": "correlcore",
  "version": "1.3.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sturmi77/correlcore.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --filter @correlcore/web dev",
    "build": "pnpm --filter @correlcore/web build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:no-token-storage": "node scripts/check-no-token-storage.mjs",
    "check:style-contract": "node scripts/check-style-contract.mjs",
    "check:style-tokens": "node scripts/check-style-tokens.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "quality:m1": "./scripts/quality-gate-m1.sh",
    "cap:sync": "pnpm --filter @correlcore/web build:capacitor && pnpm --filter @correlcore/android cap:sync",
    "cap:open": "pnpm --filter @correlcore/android cap:open",
    "cap:assemble:debug": "pnpm cap:sync && pnpm --filter @correlcore/android assemble:debug",
    "cap:assemble:release": "pnpm cap:sync && pnpm --filter @correlcore/android assemble:release",
    "prepare": "git config core.hooksPath .husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3"
  }
}
