# CorrelCore — Quickstart environment (homelab / eval)
# Generated by scripts/bootstrap-selfhost-env.sh --quickstart
# See docs/selfhost/INSTALL.md Path B

APP_ENV=staging
TAILSCALE_IP=127.0.0.1
WEB_HOST_PORT=3010

# Secrets below are placeholders — bootstrap replaces them.
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
# Custom symptom slug HMAC (ADR-0039) — required for migration 027+;
# bootstrap generates this. Manual: python -c 'import secrets; print(secrets.token_hex(32))'
SLUG_HMAC_KEY=CHANGE_ME

# CORS + mail links (bootstrap sets from TAILSCALE_IP + WEB_HOST_PORT)
CORS_ORIGINS=http://127.0.0.1:3010
FRONTEND_BASE_URL=http://127.0.0.1:3010
COOKIE_SECURE=false

# Mailpit defaults (verify emails in UI at http://127.0.0.1:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@correlcore.local

# Optional profiles:
#   worker — insights + account cleanup
#   digest — weekly in-app digest (Sunday 17:00 UTC)
# COMPOSE_PROFILES=worker
# COMPOSE_PROFILES=worker,digest

IMAGE_TAG=latest
IMAGE_REGISTRY=ghcr.io/sturmi77
