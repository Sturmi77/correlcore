# MoodSync — Umgebungsvariablen
# Kopiere diese Datei nach .env und passe alle Werte an.
#
# ⚠️  WICHTIG: Niemals .env in Git committen!
# ⚠️  ENCRYPTION_KEY separat aufbewahren (nicht nur im Backup des Servers!)
#
# Diese Datei deckt alle Variablen ab, die backend/app/core/config.py liest.
# Bei Änderungen an config.py: diese Datei ebenfalls anpassen (siehe Issue #41).

# ── App-Metadaten ─────────────────────────────────────────────────────────────
APP_ENV=production           # development | staging | production
APP_VERSION=0.0.1            # informativ; sollte zur ausgelieferten Image-Tag-Version passen
DEBUG=false                  # NIE true in Produktion (gibt Stack-Traces an Clients)

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=moodsync.example.com
LETSENCRYPT_EMAIL=admin@example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=moodsync
POSTGRES_USER=moodsync
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
# DATABASE_URL wird im docker-compose.yml aus den POSTGRES_*-Variablen zusammengebaut.
# Für lokales Dev (ohne Docker) hier direkt setzen:
# DATABASE_URL=postgresql+asyncpg://moodsync:moodsync@localhost:5432/moodsync

# ── Redis ─────────────────────────────────────────────────────────────────────
# Muss gesetzt sein — Redis läuft mit Passwort-Auth
REDIS_PASSWORD=CHANGE_ME_redis_password_here
# REDIS_URL wird im docker-compose.yml aus REDIS_PASSWORD zusammengebaut.
# Für lokales Dev:
# REDIS_URL=redis://:changeme@localhost:6379/0

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
# Root-Credentials für den MinIO-Server selbst (vom MinIO-Container gelesen):
MINIO_ROOT_USER=moodsync
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_here
# Console nur intern erreichbar — Zugriff via SSH-Tunnel:
# ssh -L 9001:localhost:9001 user@server
#
# App-seitige MinIO-Konfiguration (von backend/app/core/config.py gelesen,
# wird im docker-compose.yml aus MINIO_ROOT_* abgeleitet):
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_PHOTOS=moodsync-photos
MINIO_SECURE=false           # true wenn MinIO direkt mit TLS angesprochen wird

# ── Verschlüsselung at-rest (KRITISCH — siehe ADR-0005) ──────────────────────
# App-Level-Verschlüsselung für Gesundheitsdaten (Art. 9 DSGVO).
# Generieren:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️  DIESEN KEY SEPARAT SICHERN — ohne ihn sind alle verschlüsselten Daten
#     unwiederbringlich verloren (auch aus Backups).
ENCRYPTION_KEY=CHANGE_ME_generate_with_fernet
# Während einer Master-Key-Rotation: hier eine Komma-separierte Liste setzen,
# neuer Key zuerst, alter Key zuletzt — siehe ADR-0005 §"Schlüssel-Rotation".
# Beispiel: ENCRYPTION_KEYS=<new>,<old>

# ── Auth / JWT (ADR-0004) ─────────────────────────────────────────────────────
# Min. 32 Byte zufällig:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_min_32_byte_random_string
JWT_ALGORITHM=HS256                # HS256 ist Standard für native JWT (Phase 1)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30


# ── CORS ──────────────────────────────────────────────────────────────────────
# Komma-separierte Liste der erlaubten Frontend-Origins.
# In Produktion typischerweise nur die eigene Domain.
CORS_ORIGINS=https://moodsync.example.com
# Lokales Dev (Vite + Storybook):
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:6006

# ── E-Mail / SMTP (für E-Mail-Verifikation, Issue #39) ───────────────────────
# Dev: MailPit im Compose-Stack (UI auf http://localhost:8025) — SMTP_HOST=mailpit,
#      SMTP_PORT=1025, SMTP_USE_TLS=false, keine Auth.
# Prod: Resend / Postmark / eigener SMTP-Relay — SMTP_HOST + SMTP_USER/PASSWORD,
#       SMTP_USE_TLS=true.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@moodsync.local
SMTP_USE_TLS=false

# Public Base-URL des Frontends — wird in Verify-Mails als Link-Praefix benutzt.
# Dev: http://localhost:5173    Prod: https://${DOMAIN}
FRONTEND_BASE_URL=http://localhost:5173

# Token-Gueltigkeit der E-Mail-Verifikation in Stunden (Default 24, ADR-0004).
EMAIL_VERIFICATION_TTL_HOURS=24

# ── Monitoring (optional, Compose-Profil: monitoring) ────────────────────────
GLITCHTIP_SECRET_KEY=CHANGE_ME_glitchtip_secret

# ── Optionale Dienste ─────────────────────────────────────────────────────────
# Authentik (Phase 2, SaaS): aktivieren via --profile auth
# AUTHENTIK_DB_PASSWORD=CHANGE_ME
# AUTHENTIK_SECRET_KEY=CHANGE_ME

# Lokales LLM für Insights (optional)
# OLLAMA_BASE_URL=http://ollama:11434

# Immich-Integration (Phase 2)
# IMMICH_BASE_URL=https://immich.example.com
# IMMICH_API_KEY=CHANGE_ME
