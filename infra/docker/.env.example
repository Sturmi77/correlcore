# MoodSync Environment Configuration
# Kopiere diese Datei nach .env und passe die Werte an.
# NIEMALS .env in Git committen!

# ────────────────────────────────
# Domain & TLS
# ────────────────────────────────
DOMAIN=moodsync.example.com
ACME_EMAIL=admin@example.com

# ────────────────────────────────
# PostgreSQL
# ────────────────────────────────
POSTGRES_DB=moodsync
POSTGRES_USER=moodsync
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://moodsync:CHANGE_ME_STRONG_PASSWORD@postgres:5432/moodsync

# ────────────────────────────────
# Redis
# ────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ────────────────────────────────
# MinIO / Object Storage
# ────────────────────────────────
MINIO_ROOT_USER=moodsync
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=moodsync-media

# ────────────────────────────────
# Application
# ────────────────────────────────
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_32
ENVIRONMENT=production
LOG_LEVEL=info

# ────────────────────────────────
# Authentik (OIDC)
# ────────────────────────────────
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_CLIENT_ID=moodsync
AUTHENTIK_CLIENT_SECRET=CHANGE_ME

# ────────────────────────────────
# Email (Resend / SMTP)
# ────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@example.com

# ────────────────────────────────
# Push Notifications (optional)
# ────────────────────────────────
# UnifiedPush
UNIFIED_PUSH_URL=

# FCM (optional Fallback)
FCM_SERVER_KEY=

# ────────────────────────────────
# Ollama (optional, lokales LLM)
# ────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# ────────────────────────────────
# Immich (optional)
# ────────────────────────────────
IMMICH_URL=
IMMICH_API_KEY=
