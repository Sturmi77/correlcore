# MoodSync — Umgebungsvariablen
# Kopiere diese Datei nach .env und passe alle Werte an.
# 
# ⚠️  WICHTIG: Niemals .env in Git committen!
# ⚠️  ENCRYPTION_KEY separat aufbewahren (nicht nur im Backup des Servers!)

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=moodsync.example.com
LETSENCRYPT_EMAIL=admin@example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=moodsync
POSTGRES_USER=moodsync
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
# Muss gesetzt sein — Redis läuft mit Passwort-Auth
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=moodsync
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_here
# Console nur intern erreichbar — Zugriff via SSH-Tunnel:
# ssh -L 9001:localhost:9001 user@server

# ── Verschlüsselung (KRITISCH) ────────────────────────────────────────────────
# App-Level-Verschlüsselung für Gesundheitsdaten (Art. 9 DSGVO)
# Generieren: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️  DIESEN KEY SEPARAT SICHERN — ohne ihn sind alle verschlüsselten Daten verloren!
ENCRYPTION_KEY=CHANGE_ME_generate_with_fernet

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Min. 32 Byte zufällig: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_min_32_byte_random_string
# Access Token Laufzeit in Minuten (Standard: 15)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh Token Laufzeit in Tagen (Standard: 30)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── E-Mail (Transactional) ────────────────────────────────────────────────────
# Resend: resend+apikey@...  oder  SMTP: smtp://user:pass@host:587
EMAIL_URL=consolemail://
FROM_EMAIL=noreply@example.com

# ── Monitoring (optional, profile: monitoring) ────────────────────────────────
GLITCHTIP_SECRET_KEY=CHANGE_ME_glitchtip_secret

# ── Optionale Dienste ─────────────────────────────────────────────────────────
# Authentik (Phase 2, SaaS): aktivieren via --profile auth
# AUTHENTIK_DB_PASSWORD=CHANGE_ME
# AUTHENTIK_SECRET_KEY=CHANGE_ME

# Lokales LLM für Insights (optional)
# OLLAMA_BASE_URL=http://ollama:11434

# Immich-Integration (Phase 2)
# IMMICH_BASE_URL=https://immich.example.com
# IMMICH_API_KEY=CHANGE_ME
