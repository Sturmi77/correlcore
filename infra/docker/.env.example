# CorrelCore — Umgebungsvariablen
# Kopiere diese Datei nach .env und passe alle Werte an.
#
# ⚠️  WICHTIG: Niemals .env in Git committen!
# ⚠️  ENCRYPTION_KEY separat aufbewahren (nicht nur im Backup des Servers!)
#
# Diese Datei deckt alle Variablen ab, die backend/app/core/config.py liest.
# Bei Änderungen an config.py: diese Datei ebenfalls anpassen (siehe Issue #41).

# ── App-Metadaten ─────────────────────────────────────────────────────────────
APP_ENV=production           # development | staging | production
APP_VERSION=1.0.6       # informativ; sollte zur ausgelieferten Image-Tag-Version passen
DEBUG=false                  # NIE true in Produktion (gibt Stack-Traces an Clients)
DEV_VIEW_ENABLED=false       # Developer-View /dev, nur fuer Diagnose bewusst aktivieren
IMAGE_TAG=v1.0.6             # recommended pin; any v1.0.x or sha-<short> for reproducible deploys
IMAGE_REGISTRY=ghcr.io/sturmi77   # or docker.io/<username> for Docker Hub (M10)
IMAGE_DIGEST=                # optional echter RepoDigest aus `docker inspect`
# GIT_COMMIT/GIT_BRANCH/BUILD_TIME werden im Release-Image eingebettet.
# Nur als manuelle lokale Overrides setzen, damit das Image-ENV nicht
# versehentlich mit "unknown" ueberschrieben wird.
# GIT_COMMIT=
# GIT_BRANCH=
# BUILD_TIME=

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=correlcore.example.com
LETSENCRYPT_EMAIL=admin@example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=correlcore
POSTGRES_USER=correlcore
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
APP_DB_USER=correlcore_app
APP_DB_PASSWORD=CHANGE_ME_app_role_password_here
# DATABASE_URL wird im docker-compose.yml aus den POSTGRES_*-Variablen zusammengebaut.
# Für lokales Dev (ohne Docker) hier direkt setzen:
# DATABASE_URL=postgresql+asyncpg://correlcore:correlcore@localhost:5432/correlcore

# ── Redis ─────────────────────────────────────────────────────────────────────
# Muss gesetzt sein — Redis läuft mit Passwort-Auth
REDIS_PASSWORD=CHANGE_ME_redis_password_here
# REDIS_URL wird im docker-compose.yml aus REDIS_PASSWORD zusammengebaut.
# Für lokales Dev:
# REDIS_URL=redis://:changeme@localhost:6379/0

# ── Object storage (M13 — photo upload) ───────────────────────────────────────
# MinIO removed from production compose in M10 Sprint 1 (no product use until M13).
# Re-add via --profile storage when photo upload ships. config.py defaults remain.
# MINIO_ROOT_USER=correlcore
# MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_here
# MINIO_ENDPOINT=minio:9000
# MINIO_BUCKET_PHOTOS=correlcore-photos
# MINIO_SECURE=false

# ── Verschlüsselung at-rest (KRITISCH — siehe ADR-0005) ──────────────────────
# App-Level-Verschlüsselung für Gesundheitsdaten (Art. 9 DSGVO).
# Generieren:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️  DIESEN KEY SEPARAT SICHERN — ohne ihn sind alle verschlüsselten Daten
#     unwiederbringlich verloren (auch aus Backups).
ENCRYPTION_KEY=CHANGE_ME_generate_with_fernet
# Während einer Master-Key-Rotation: hier eine Komma-separierte Liste setzen,
# neuer Key zuerst, alter Key zuletzt — siehe ADR-0005 §"Schlüssel-Rotation".
# Beispiel: ENCRYPTION_KEYS=<new>,<old>

# Custom-Symptom-Slug HMAC (ADR-0039, Issue #62) — separat von ENCRYPTION_KEY.
# Generieren:
#   python -c "import secrets; print(secrets.token_hex(32))"
SLUG_HMAC_KEY=CHANGE_ME_generate_with_secrets_token_hex

# ── Auth / JWT (ADR-0004) ─────────────────────────────────────────────────────
# Min. 32 Byte zufällig:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_min_32_byte_random_string
JWT_ALGORITHM=HS256                # HS256 ist Standard für native JWT (Phase 1)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Auth-Cookie Secure-Flag (ADR-0006).
# Default-Heuristik: True ausser APP_ENV=development. Setzen Sie
# COOKIE_SECURE=false NUR in HTTP-only-Setups (z. B. lokales Tailscale
# ohne TLS-terminierenden Reverse-Proxy) — andernfalls verwirft der
# Browser das Set-Cookie und Login schlägt fehl. In APP_ENV=production
# verbietet der Settings-Validator COOKIE_SECURE=false.
# COOKIE_SECURE=true


# ── CORS ──────────────────────────────────────────────────────────────────────
# Komma-separierte Liste der erlaubten Frontend-Origins.
# In Produktion typischerweise nur die eigene Domain.
CORS_ORIGINS=https://correlcore.example.com
# Lokales Dev (Vite + Storybook):
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:6006

# ── E-Mail / SMTP (für E-Mail-Verifikation, Issue #39) ───────────────────────
# Dev: MailPit im Compose-Stack (UI auf http://localhost:8025) — SMTP_HOST=mailpit,
#      SMTP_PORT=1025, SMTP_USE_TLS=false, keine Auth.
# Prod: Resend / Postmark / eigener SMTP-Relay — SMTP_HOST + SMTP_USER/PASSWORD,
#       SMTP_USE_TLS=true.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@correlcore.local
SMTP_USE_TLS=false

# Public Base-URL des Frontends — wird in Verify-Mails als Link-Praefix benutzt.
# Dev: http://localhost:5173    Prod: https://${DOMAIN}
FRONTEND_BASE_URL=http://localhost:5173

# Token-Gueltigkeit der E-Mail-Verifikation in Stunden (Default 24, ADR-0004).
EMAIL_VERIFICATION_TTL_HOURS=24

# Auto-Cleanup fuer nicht verifizierte Accounts (DSGVO Speicherbegrenzung).
# Accounts, die den Verify-Link nie klicken, werden nach dieser Frist geloescht.
UNVERIFIED_CLEANUP_DAYS=7
ANALYTICS_MIN_TAG_USAGES=10

# ── Monitoring (optional, Compose-Profil: monitoring) ────────────────────────
# GlitchTip Web-UI + ingest. DSN format: https://<key>@errors.<domain>/<project>
# Leave empty to disable error reporting (no outbound traffic).
GLITCHTIP_DSN=
GLITCHTIP_SECRET_KEY=CHANGE_ME_glitchtip_secret

# ── Optionale Dienste ─────────────────────────────────────────────────────────
# Authentik (Phase 2, SaaS): aktivieren via --profile auth
# AUTHENTIK_DB_PASSWORD=CHANGE_ME
# AUTHENTIK_SECRET_KEY=CHANGE_ME

# Lokales LLM für Insights (optional)
# OLLAMA_BASE_URL=http://ollama:11434

# Immich-Integration (Phase 2)
# IMMICH_BASE_URL=https://immich.example.com
# IMMICH_API_KEY=CHANGE_ME

# FCM (M11 Sprint 5) — Play/SaaS only; leave off for selfhost / UnifiedPush (M4.2).
# Requires API image/venv with firebase-admin: uv sync --extra fcm
# FCM_ENABLED=false
# FCM_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
