# MoodSync — Beispiel-Konfiguration für User-Test-Stack
# ──────────────────────────────────────────────────────────────────────────
# Kopie nach `.env` und Werte ausfüllen.  Datei ist gitignored.
#   cp .env.example .env

# === Image-Tag ============================================================
# 'latest' = aktuellster main-Build. Für stabilen Test besser semver-Tag wie
# v0.2.0 oder sha-abc1234 angeben (siehe GHCR-Pakete).
IMAGE_TAG=latest

# === Developer-View / Versionsdiagnose ===================================
# Default off. Aktivieren, wenn /dev GitHub-Commit, Image-Tag und optional
# echten RepoDigest anzeigen soll. RepoDigest nach Pull z. B.:
#   docker inspect ghcr.io/sturmi77/moodsync-api:${IMAGE_TAG} --format='{{index .RepoDigests 0}}'
DEV_VIEW_ENABLED=false
IMAGE_DIGEST=
# GIT_COMMIT/GIT_BRANCH/BUILD_TIME sind im Release-Image eingebettet.
# Nur fuer lokale Sonderfaelle aktiv setzen, sonst nicht ueberschreiben.
# GIT_COMMIT=
# GIT_BRANCH=
# BUILD_TIME=

# === Tailscale-Bind =======================================================
# IPv4 deines Servers im Tailnet (`tailscale ip -4`).
# Default ist 127.0.0.1 → nur vom Host selbst erreichbar.
# Tailnet-Beispiel: 100.101.102.103
TAILSCALE_IP=127.0.0.1

# === Host-Ports ============================================================
# Falls auf dem Host bereits ein anderer Self-Hosted-Dienst auf 8000/3000
# lauscht (z.B. Paperless auf 8000, Grafana auf 3000), hier ausweichende
# Ports setzen. Container-interne Ports bleiben fix.
# WICHTIG: Änderst du WEB_HOST_PORT, müssen die Ports in CORS_ORIGINS unten
# entsprechend angepasst werden.
API_HOST_PORT=8210
WEB_HOST_PORT=3000

# === App-Modus ============================================================
APP_ENV=staging

# === CORS =================================================================
# Komma-separierte Origins, die das Frontend erreichen darf.
# Beispiel mit Tailscale-MagicDNS-Hostname:
#   CORS_ORIGINS=http://moodsync.tail-scale.ts.net:3000,http://100.101.102.103:3000
CORS_ORIGINS=http://127.0.0.1:3000

# === Frontend → Backend ===================================================
# Wird in das Web-Image als Build-Time-Variable gebacken (CI). Zur Laufzeit
# nutzt der SvelteKit-Server diesen Pfad für Fetches.
VITE_API_BASE_URL=/api/v1

# === Secrets ==============================================================
# SECRET_KEY: ≥32 Bytes (URL-safe). Generieren:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# ENCRYPTION_KEY: Fernet-Key (32 random Bytes, URL-safe base64). Generieren:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# WICHTIG: Wenn dieser Key verloren geht, sind alle verschlüsselten Felder
# unentschlüsselbar. Sicher backuppen (z. B. Bitwarden / Vaultwarden).
ENCRYPTION_KEY=

# === Postgres =============================================================
POSTGRES_DB=moodsync
POSTGRES_USER=moodsync
# POSTGRES_PASSWORD: ≥20 Zeichen, kein @ oder /  (Asyncpg-Konflikt im DSN).
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
POSTGRES_PASSWORD=

# === Redis ================================================================
# REDIS_PASSWORD: ≥20 Zeichen.
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
REDIS_PASSWORD=

# === SMTP =================================================================
# Defaults schicken alle Mails an den lokalen Mailpit-Container.
# Web-UI: http://${TAILSCALE_IP}:8025
# Für echten Mail-Versand SMTP_HOST/USER/PASSWORD setzen — STARTTLS schaltet
# sich dann automatisch ein (Backend-Default 'auto' seit PR #94: TLS an, sobald
# SMTP_USER nicht-leer ist). Explizit überschreiben mit SMTP_USE_TLS=true|false.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@moodsync.local
# SMTP_USE_TLS=

# === Frontend-Basis-URL (für E-Mail-Links) ================================
# Wird vom Backend in Verify-/Reset-Mails als Präfix verwendet:
#   {FRONTEND_BASE_URL}/auth/verify-email?token=...
# Default (http://localhost:5173) ist nur für lokale Vite-Dev-Sessions
# korrekt. Im user-test-Stack auf den extern erreichbaren Web-URL setzen,
# damit User die Mail-Links klicken können:
#   FRONTEND_BASE_URL=http://${TAILSCALE_IP}:${WEB_HOST_PORT}
# Beispiel:
#   FRONTEND_BASE_URL=http://100.120.157.82:3010
FRONTEND_BASE_URL=http://localhost:3010

# Auto-Cleanup fuer nicht verifizierte Accounts (DSGVO Speicherbegrenzung).
# Accounts, die den Verify-Link nie klicken, werden nach dieser Frist geloescht.
UNVERIFIED_CLEANUP_DAYS=7

# === GlitchTip (nur bei --profile monitoring) =============================
# GLITCHTIP_SECRET_KEY: ≥50 Zeichen, separat von SECRET_KEY.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
GLITCHTIP_SECRET_KEY=
