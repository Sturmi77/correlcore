# CorrelCore — Dockhand Stack-Konfiguration
# ──────────────────────────────────────────────────────────────────────────
# In Dockhand: Stack-Detail → Tab "Environment" → Werte hier pflegen
# (oder als Datei .env neben compose.yaml ablegen, wird automatisch
# geladen). Datei darf nicht ins Repo committed werden.

# === Image-Tag =============================================================
# Empfohlen: pinned Tag (sha-XXXXXXX oder vX.Y.Z). 'latest' funktioniert,
# aber Dockhands Vulnerability-Scanner (Grype/Trivy) vergleicht beim Update
# alt vs. neu — pinned Tags sind reproducierbarer.
# Aktuell verfügbare Tags: ghcr.io/sturmi77/correlcore-{api,web}
IMAGE_TAG=latest

# === Developer-View / Versionsdiagnose ===================================
# Default off. Aktivieren, wenn /dev GitHub-Commit, Image-Tag und optional
# echten RepoDigest anzeigen soll. RepoDigest nach Pull z. B.:
#   docker inspect ghcr.io/sturmi77/correlcore-api:${IMAGE_TAG} --format='{{index .RepoDigests 0}}'
DEV_VIEW_ENABLED=false
IMAGE_DIGEST=
# GIT_COMMIT/GIT_BRANCH/BUILD_TIME sind im Release-Image eingebettet.
# Nur fuer lokale Sonderfaelle aktiv setzen, sonst nicht ueberschreiben.
# GIT_COMMIT=
# GIT_BRANCH=
# BUILD_TIME=

# === Tailscale-Bind ========================================================
# IPv4 deines Servers im Tailnet (`tailscale ip -4`).
# Default ist 127.0.0.1 → nur vom Host selbst erreichbar.
# Tailnet-Beispiel: 100.101.102.103
TAILSCALE_IP=127.0.0.1

# === Host-Port (nur Web) ===================================================
# Seit ADR-0011 (Web-interner Reverse-Proxy) hat NUR der Web-Container
# noch ein Host-Port-Mapping. Die API ist ausschließlich intern im
# Compose-Netz unter http://api:8000 erreichbar — der Browser ruft sie
# nie direkt auf, sondern immer über /api/* am Web-Port. Damit gibt es
# auch keine CORS-Sonderfälle mehr (Same-Origin).
#
# WEB_HOST_PORT ausweichen, falls auf dem Host bereits ein anderer
# Self-Hosted-Dienst auf 3000 lauscht (z. B. Grafana). Container-interner
# Port bleibt fix 3000.
#
# WICHTIG: Wenn du WEB_HOST_PORT änderst, FRONTEND_BASE_URL weiter unten
# entsprechend anpassen (wird in Verifikations-Mails als Link-Präfix
# verwendet). Browser/PWA sind seit ADR-0011 Same-Origin (Proxy). Die
# Capacitor-App ruft die API cross-origin auf — `https://localhost` wird
# serverseitig automatisch erlaubt; Web-Origins weiterhin hier listen.
#
# (API_HOST_PORT existiert nicht mehr — falls noch in alten .env-Files,
# kann gelöscht werden. Wird von compose.yaml ignoriert.)
WEB_HOST_PORT=3010

# === App-Modus =============================================================
APP_ENV=staging

# === Auth-Cookies (ADR-0006) ==============================================
# Auth-Cookies (access_token / refresh_token) tragen standardmäßig das
# `Secure`-Attribut, sobald `APP_ENV != development`. Browser verwerfen
# `Secure`-Cookies bei HTTP-Origins (z. B. Tailscale-IP ohne TLS-Proxy)
# stillschweigend → Login-Flow scheitert.
#
# In diesem Stack läuft Web meist über plain HTTP (Tailscale-IP:WEB_HOST_PORT,
# ohne Reverse-Proxy mit TLS davor) — daher Secure explizit ausschalten:
COOKIE_SECURE=false
# Sobald TLS terminiert wird (Reverse-Proxy mit Cert), die Zeile entfernen
# oder auf `true` setzen. In `APP_ENV=production` ist `false` ohnehin
# durch den Settings-Validator gesperrt (ADR-0006).

# === CORS ==================================================================
# Komma-separierte Browser/PWA-Origins. Capacitor (https://localhost) wird
# von der API immer ergänzt — hier nicht nötig, schadet aber nicht.
# Format: http://<host>:<WEB_HOST_PORT>  (mit dem Port aus dem Block oben)
# Beispiel mit Tailscale-MagicDNS:
#   CORS_ORIGINS=http://correlcore.tail-scale.ts.net:3010,http://100.101.102.103:3010
CORS_ORIGINS=http://127.0.0.1:3010

# === Frontend → Backend ====================================================
# VITE_API_BASE_URL gibt es nicht mehr als Stack-Variable. Seit ADR-0011
# ist der Wert fest auf /api/v1 gepinnt und das Web-Image proxyt /api/*
# serverseitig an INTERNAL_API_URL (Default http://api:8000) weiter.
# Der Default greift im Compose-Netz automatisch über den Service-Namen,
# daher ist hier nichts zu setzen.
#
# Override nur nötig, wenn der API-Service im Compose umbenannt oder
# extern liegt — dann am Web-Container z. B.:
#   INTERNAL_API_URL=http://api:8000
# Siehe docs/adr/0011-web-internal-reverse-proxy.md.

# === Secrets ===============================================================
# SECRET_KEY: ≥32 Bytes (URL-safe). Generieren:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# ENCRYPTION_KEY: Fernet-Key (32 random Bytes, URL-safe base64). Generieren:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# WICHTIG: Wenn dieser Key verloren geht, sind alle verschlüsselten Felder
# unentschlüsselbar. Sicher backuppen (z. B. Bitwarden / Vaultwarden).
ENCRYPTION_KEY=

# SLUG_HMAC_KEY: Custom-Symptom-Slug HMAC (ADR-0039), separat von ENCRYPTION_KEY.
#   python -c 'import secrets; print(secrets.token_hex(32))'
# Pflicht in APP_ENV=staging|production (≥32 Zeichen, nicht CHANGE_ME*).
SLUG_HMAC_KEY=

# === Postgres ==============================================================
POSTGRES_DB=correlcore
POSTGRES_USER=correlcore
APP_DB_USER=correlcore_app
# POSTGRES_PASSWORD: ≥20 Zeichen, kein @ oder /  (Asyncpg-Konflikt im DSN).
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# === Redis =================================================================
# REDIS_PASSWORD: ≥20 Zeichen.
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
REDIS_PASSWORD=

# === SMTP ==================================================================
# Defaults schicken alle Mails an den lokalen Mailpit-Container.
# Web-UI: http://${TAILSCALE_IP}:8025
#
# SMTP_USE_TLS bleibt absichtlich leer: Backend-Default ist seit PR #94
# 'auto' — STARTTLS schaltet sich automatisch ein, sobald SMTP_USER einen
# nicht-leeren Wert hat (echter Relay), und bleibt aus, wenn SMTP_USER leer
# ist (Mailpit/MailHog auf 1025 ohne TLS). Wer den Smart-Default überschreiben
# will, setzt explizit SMTP_USE_TLS=true oder SMTP_USE_TLS=false.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@correlcore.local
# SMTP_USE_TLS=         # leer = auto (siehe oben)

# === MinIO placeholder (M13 photos not shipped yet) ========================
# Production Settings reject CHANGE_ME* / secrets shorter than 16 chars.
# Compose passes this into migrate/api/worker — setting it only in Dockhand
# UI without the compose mapping has no effect.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(24))'
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET

# === Frontend-Basis-URL (für E-Mail-Links) ================================
# Wird vom Backend in Verify-/Reset-Mails als Präfix verwendet:
#   {FRONTEND_BASE_URL}/auth/verify-email?token=...
# Default (http://localhost:5173) ist nur für lokale Vite-Dev-Sessions
# korrekt. Im Dockhand-Stack auf den extern erreichbaren Web-URL setzen,
# damit User die Mail-Links klicken können:
#   FRONTEND_BASE_URL=http://${TAILSCALE_IP}:${WEB_HOST_PORT}
# Beispiel:
#   FRONTEND_BASE_URL=http://100.120.157.82:3010
FRONTEND_BASE_URL=http://localhost:3010

# Auto-Cleanup fuer nicht verifizierte Accounts (DSGVO Speicherbegrenzung).
# Accounts, die den Verify-Link nie klicken, werden nach dieser Frist geloescht.
UNVERIFIED_CLEANUP_DAYS=7
ANALYTICS_MIN_TAG_USAGES=10

# === GlitchTip (nur bei aktivem Profile 'monitoring') ======================
# GLITCHTIP_SECRET_KEY: ≥50 Zeichen, separat von SECRET_KEY.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
GLITCHTIP_SECRET_KEY=
