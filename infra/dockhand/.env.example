# MoodSync — Dockhand Stack-Konfiguration
# ──────────────────────────────────────────────────────────────────────────
# In Dockhand: Stack-Detail → Tab "Environment" → Werte hier pflegen
# (oder als Datei .env neben compose.yaml ablegen, wird automatisch
# geladen). Datei darf nicht ins Repo committed werden.

# === Image-Tag =============================================================
# Empfohlen: pinned Tag (sha-XXXXXXX oder vX.Y.Z). 'latest' funktioniert,
# aber Dockhands Vulnerability-Scanner (Grype/Trivy) vergleicht beim Update
# alt vs. neu — pinned Tags sind reproducierbarer.
# Aktuell verfügbare Tags: ghcr.io/sturmi77/moodsync-{api,web}
IMAGE_TAG=latest

# === Tailscale-Bind ========================================================
# IPv4 deines Servers im Tailnet (`tailscale ip -4`).
# Default ist 127.0.0.1 → nur vom Host selbst erreichbar.
# Tailnet-Beispiel: 100.101.102.103
TAILSCALE_IP=127.0.0.1

# === Host-Ports ============================================================
# Falls auf dem Host bereits ein anderer Self-Hosted-Dienst auf 8000/3000
# lauscht (z.B. Paperless auf 8000, Grafana auf 3000), hier ausweichende
# Ports setzen. Container-interne Ports bleiben fix bei 8000 (API) und
# 3000 (Web). Port 8210 ist absichtlich gewählt: kollidiert mit keinem
# der üblichen Selfhosted-Tools (Plex 32400, Portainer 9000, Home Assistant
# 8123, Jellyfin 8096, *arr 7878/8989 etc.).
#
# WICHTIG: Wenn du diese Ports änderst, müssen die in CORS_ORIGINS unten
# (für WEB_HOST_PORT) entsprechend angepasst werden — sonst blockiert der
# Browser API-Calls vom Frontend mit CORS-Fehler.
API_HOST_PORT=8210
WEB_HOST_PORT=3000

# === App-Modus =============================================================
APP_ENV=staging

# === CORS ==================================================================
# Komma-separierte Origins, die das Frontend erreichen darf.
# Format: http://<host>:<WEB_HOST_PORT>  (mit dem Port aus dem Block oben)
# Beispiel mit Tailscale-MagicDNS:
#   CORS_ORIGINS=http://moodsync.tail-scale.ts.net:3000,http://100.101.102.103:3000
CORS_ORIGINS=http://127.0.0.1:3000

# === Frontend → Backend ====================================================
VITE_API_BASE_URL=/api/v1

# === Secrets ===============================================================
# SECRET_KEY: ≥32 Bytes (URL-safe). Generieren:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# ENCRYPTION_KEY: Fernet-Key (32 random Bytes, URL-safe base64). Generieren:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# WICHTIG: Wenn dieser Key verloren geht, sind alle verschlüsselten Felder
# unentschlüsselbar. Sicher backuppen (z. B. Bitwarden / Vaultwarden).
ENCRYPTION_KEY=

# === Postgres ==============================================================
POSTGRES_DB=moodsync
POSTGRES_USER=moodsync
# POSTGRES_PASSWORD: ≥20 Zeichen, kein @ oder /  (Asyncpg-Konflikt im DSN).
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
POSTGRES_PASSWORD=

# === Redis =================================================================
# REDIS_PASSWORD: ≥20 Zeichen.
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
REDIS_PASSWORD=

# === SMTP ==================================================================
# Defaults schicken alle Mails an den lokalen Mailpit-Container.
# Web-UI: http://${TAILSCALE_IP}:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@moodsync.local

# === GlitchTip (nur bei aktivem Profile 'monitoring') ======================
# GLITCHTIP_SECRET_KEY: ≥50 Zeichen, separat von SECRET_KEY.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
GLITCHTIP_SECRET_KEY=
