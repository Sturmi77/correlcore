node_modules/
.capacitor/

# Local machine / IDE
local.properties
*.iml
.idea/
.gradle/
captures/
.DS_Store

# Synced web assets — regenerated by `pnpm cap:sync` / CI
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Cordova plugin bridge (regenerated on sync)
android/capacitor-cordova-android-plugins/

# Build outputs (platform source under android/ is committed)
*.apk
*.aab
*.ap_
*.dex
android/**/build/
android/**/.cxx/
android/app/release/
android/*/release/

# Keystore material — never commit
*.jks
*.keystore
keystore.properties
android/keystore.properties

# Firebase (Play/SaaS only — never commit real project files)
android/app/google-services.json
