<?xml version="1.0" encoding="utf-8"?>
<!--
  Sideload flavor only — Health Connect (M8). The Play flavor ships HC-free
  (AP-HC Option A, docs/M11_PLAY_STORE_GAP_ANALYSIS.md §4): no health.* permissions,
  no HC declaration, no HC review. These entries are merged into the sideload
  variant's manifest on top of src/main/AndroidManifest.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      androidx.health.connect requires minSdk 26, but the app keeps minSdk 24.
      Health Connect is unavailable below 26 (guarded at runtime via
      HealthConnectClient.getSdkStatus), so we override the library's floor.
      Only needed where connect-client is on the classpath (sideload flavor).
    -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <!--
      Package visibility (Android 11+) hides the separately installed Health
      Connect provider unless queried explicitly.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>
        <!-- Health Connect permission rationale (pre-Android 14 HC APK) -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ framework Health Connect rationale entry point -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

    <!-- Health Connect read, sleep + heart rate only (data minimization) -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
</manifest>
