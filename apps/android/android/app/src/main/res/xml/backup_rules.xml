<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 full backup exclusions (pairs with allowBackup=false). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
