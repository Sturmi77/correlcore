{
  "name": "@correlcore/web",
  "version": "1.6.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "build:capacitor": "CAPACITOR_BUILD=1 VITE_CAPACITOR=1 svelte-kit sync && CAPACITOR_BUILD=1 VITE_CAPACITOR=1 vite build",
    "preview": "vite preview",
    "lint": "svelte-kit sync && eslint . && svelte-check --tsconfig ./tsconfig.json",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts tests/e2e/a11y-smoke.spec.ts",
    "test:e2e:mobile": "playwright test tests/e2e/mobile-entry-foundation.spec.ts tests/e2e/mobile-trends-foundation.spec.ts tests/e2e/mobile-insights-foundation.spec.ts tests/e2e/mobile-supporting-flows.spec.ts tests/e2e/m7-insights-mobile.spec.ts tests/e2e/mobile-theme-parity.spec.ts",
    "test:e2e:journeys": "playwright test tests/e2e/user-journeys.spec.ts",
    "test:e2e:gdpr": "playwright test tests/e2e/gdpr-self-service.spec.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/push-notifications": "8.1.2",
    "@lucide/svelte": "^1.41.0",
    "@sentry/browser": "^10.73.0",
    "@sentry/node": "^10.73.0",
    "dexie": "^4.4.4",
    "svelte-i18n": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@correlcore/api-types": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.11"
  }
}
